{
  "name": "basketball-coach-strategy-functions",
  "version": "1.0.0",
  "description": "練習メニュー配信 Cloud Function（Firestore → 既存エンジン/描画 → HTML）",
  "type": "module",
  "main": "dist/index.mjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npx -y esbuild@0.24.0 index.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/index.mjs && node -e \"const fs=require('fs');fs.rmSync('dist/styles',{recursive:true,force:true});fs.cpSync('../ui/styles','dist/styles',{recursive:true});fs.rmSync('dist/fixtures',{recursive:true,force:true});fs.cpSync('fixtures','dist/fixtures',{recursive:true})\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "^10.9.1"
  },
  "overrides": {
    "@fastify/busboy@3": ">=3.2.3 <4",
    "@grpc/grpc-js@1": ">=1.14.6 <2",
    "body-parser@1": ">=1.20.8 <2",
    "fast-xml-parser@5": ">=5.10.1 <6",
    "protobufjs@7": ">=7.6.5 <8",
    "proxy-addr@2": ">=2.0.8 <3",
    "qs@6": ">=6.16.1 <7",
    "uuid@<11.1.1": ">=11.1.1 <12"
  }
}
